# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGIN=*

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Uffizio GPS Tracking (Kimii Telematics account)
UFFIZIO_BASE_URL=http://13.245.46.90
UFFIZIO_USERNAME=nccg@brighton.co.ke
UFFIZIO_PASSWORD=Vision@123!!
UFFIZIO_PROJECT_ID=49
UFFIZIO_COMPANY=Nairobi Emergency Operation Center

# Google Maps - reverse-geocode driver GPS → place names (Kilimani, Westlands, …)
# Enable the Geocoding API for this key in Google Cloud Console.
GOOGLE_MAPS_KEY=

# Google Sign-In for Drivers / EMTs / Nurses (match onboarded User.email).
# Comma-separated OAuth 2.0 client IDs from Google Cloud Console:
#   - Web client (used by frontend GIS + as Flutter serverClientId)
#   - Android client (package com.example.eocmcg + SHA-1)
#   - iOS client (optional)
# Create OAuth clients under APIs & Services → Credentials. Consent screen required.
GOOGLE_CLIENT_IDS=
# Optional — only needed for auth-code exchange flows (ID-token verify does not use it).
GOOGLE_CLIENT_SECRET=
